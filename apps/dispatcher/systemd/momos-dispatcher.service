[Unit]
Description=MomOS dispatcher (agent jobs and the bar plugin socket)
Documentation=https://github.com/amicklabs/mom-os/blob/main/docs/setup/11-dispatcher.md
After=network-online.target
Wants=network-online.target
# Give up after 5 quick crashes in 10 minutes rather than spin.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/momos-dispatcher
Restart=always
RestartSec=30
# claude and mom live in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# A running agent gets SIGTERM with the service; its lease then runs out and
# the job can be picked up again.
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
