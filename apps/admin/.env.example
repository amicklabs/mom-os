# Copy to apps/admin/.env.local for local development, or set these in Vercel.
# `pnpm --filter @momos/admin build` needs none of them: the app reads them per
# request and shows a setup page listing whatever is missing.

# Convex deployment URL (the .convex.cloud one). For the dev deployment, see
# CONVEX_URL in packages/backend/.env.local.
NEXT_PUBLIC_CONVEX_URL=

# Clerk keys from the Clerk dashboard, API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set on the Convex deployment, not here (npx convex env set NAME value, run in
# packages/backend):
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
#   ADMIN_EMAILS              comma-separated emails allowed into this app
#   DISPATCHER_TOKEN          shared secret for the dispatcher
#   TELEGRAM_BOT_TOKEN        from BotFather
#   TELEGRAM_WEBHOOK_SECRET   random string, also passed to setWebhook as secret_token
#   TELEGRAM_ADMIN_IDS        comma-separated numeric Telegram user ids
#   REPORT_TIMEZONE           time zone for the Sunday 6 PM weekly report
#                             (default America/New_York)
