#!/bin/bash
# Runs wayvnc for momos-wayvnc.service.
#
# Listens on the Tailscale IPv4 address when Tailscale is up, otherwise on
# 127.0.0.1 only. Never on 0.0.0.0. While bound to 127.0.0.1 it checks for a
# Tailscale address every 30 seconds and exits when one appears, so systemd
# restarts it on the right address.
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/wayvnc/config"
port=5900 # set in the config file; only used in log lines

tailscale_ip() {
  command -v tailscale >/dev/null 2>&1 || return 1
  local ip
  ip=$(tailscale ip -4 2>/dev/null | head -n1) || return 1
  [[ $ip =~ ^100\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s\n' "$ip"
}

if [[ ! -r $config ]]; then
  echo "momos-wayvnc: $config is missing; run install.sh wayvnc" >&2
  exit 1
fi

if address=$(tailscale_ip); then
  echo "momos-wayvnc: listening on Tailscale address $address:$port"
  exec wayvnc --render-cursor --config "$config" "$address"
fi

echo "momos-wayvnc: Tailscale is down; listening on 127.0.0.1:$port only"
wayvnc --render-cursor --config "$config" 127.0.0.1 &
child=$!
trap 'kill "$child" 2>/dev/null || true' EXIT TERM INT

while kill -0 "$child" 2>/dev/null; do
  sleep 30 &
  wait $! || true
  if tailscale_ip >/dev/null; then
    echo "momos-wayvnc: Tailscale is up; restarting on its address"
    exit 0
  fi
done

wait "$child"
